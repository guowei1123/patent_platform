# OpenAI Compatible 配置 - Chat 模型
OPENAI_API_KEY=sk-8daaf81**************e23309
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=your-chat-model
OPENAI_VISION_MODEL=your-vision-model
# OpenAI Compatible 配置 - Embedding 模型 (独立配置,可与 Chat 模型使用不同服务商)
# 未配置时回退到 OPENAI_API_KEY / OPENAI_BASE_URL
OPENAI_EMBEDDING_API_KEY=your-embedding-api-key
OPENAI_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_EMBEDDING_MODEL=your-embedding-model
OPENAI_IMAGE_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/embeddings/multimodal-embedding/multimodal-embedding
OPENAI_IMAGE_EMBEDDING_MODEL=your-image-embedding-model

# Langfuse 数据分析
LANGFUSE_SECRET_KEY = "sk-lf-******-cfec74cb354a"
LANGFUSE_PUBLIC_KEY = "pk-lf-******-56a45af85694"
LANGFUSE_BASE_URL = "https://******"

# Postgres 数据库配置
POSTGRES_HOST=your-postgres-host
POSTGRES_PORT=your-postgres-port
POSTGRES_USER=your-postgres-user
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_DB=your-postgres-db
POSTGRES_SCHEMA=your-postgres-schema
POSTGRES_SSL=false

# Mastra 智能体（可选：如未设置 MASTRA_DATABASE_URL，则复用以上 POSTGRES 配置）
# MASTRA_DATABASE_URL=postgresql://user:password@host:5432/database
AGENT_MAX_STEPS=12

# 通用问答 RAG：启用后，每次问答先检索 WeKnora，再由现有模型生成答案。
# URL 为 WeKnora 服务根地址，不带 /api/v1；所有配置仅限服务端。
QA_RAG_ENABLED=false
WEKNORA_BASE_URL=http://localhost:8080
WEKNORA_API_KEY=
# 仅配置允许本平台所有问答用户访问的公共知识库，多个 ID 用逗号分隔。
WEKNORA_KNOWLEDGE_BASE_IDS=
QA_RAG_RECALL_COUNT=30
QA_RAG_TOP_K=6
QA_RAG_MAX_CONTEXT_CHARS=16000
QA_RAG_TIMEOUT_MS=20000
QA_RAG_REWRITE=true
# 可选：兼容 Cohere /rerank 请求和 results[{index,relevance_score}] 响应。
# 三项须同时设置；未配置时使用混合召回排名 + MMR。
QA_RERANK_URL=
QA_RERANK_API_KEY=
QA_RERANK_MODEL=

# S3 OSS 兼容存储配置
OSS_ENDPOINT=https://oss-cn-shenzhen.aliyuncs.com
OSS_BUCKET=your-bucket-name
OSS_ACCESS_KEY=your-access-key-id
OSS_SECRET_KEY=your-secret-access-key
# 可选：CNIPA ETL 的全文字段名称。未设置时系统会在 cnipa.patent 中自动识别常见字段名。
# CNIPA_PATENT_CLAIMS_COLUMN=claims
# CNIPA_PATENT_DESCRIPTION_COLUMN=description
# CNIPA_PATENT_DRAWINGS_COLUMN=drawings

# 专利附图：须与专利 ETL 使用相同存储，独立于通用 OSS_* 配置。
# 使用 MinIO 时取消注释并填写实际值：
# OBJECT_STORAGE_TYPE=minio
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET_NAME=patent-images
# MINIO_REGION=us-east-1
# 使用阿里云 OSS 时配置：
# CNIPA_OSS_ENDPOINT=https://oss-cn-shenzhen.aliyuncs.com
# CNIPA_OSS_REGION=cn-shenzhen
# CNIPA_OSS_ACCESS_KEY_ID=
# CNIPA_OSS_ACCESS_KEY_SECRET=
# CNIPA_OSS_BUCKET_NAME=
