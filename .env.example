REDIS_URL=redis://127.0.0.1:6379/0
IPC_EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=embeddinggemma:latest
IPC_VECTOR_REDIS_KEY=classifications:ipc:vectors:embeddinggemma
CNIPA_PG_HOST=127.0.0.1
CNIPA_PG_PORT=5432
CNIPA_PG_DB=patent_etl
CNIPA_PG_USER=postgres
CNIPA_PG_PASSWORD=your-cnipa-postgres-password
CNIPA_PG_SSL=false

# S3 OSS 兼容存储配置
